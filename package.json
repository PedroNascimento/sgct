    "test:db": "node scripts/run-database-tests.cjs all",
    "test:rls": "node scripts/run-database-tests.cjs rls",
    "test:integration": "node scripts/run-database-tests.cjs integration",
    "typecheck": "tsc --noEmit --incremental false",
    "inventory:access": "node scripts/generate-access-inventory.cjs",
    "inventory:check": "node scripts/generate-access-inventory.cjs --check",
    "seed:super-admin": "tsx scripts/seed-bootstrap.ts",
