# ============================================================
# SGCT — Variáveis de Ambiente
# Copie este arquivo para .env.local (nunca commite o .env.local!)
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # NUNCA expor no client — só Edge Functions/jobs/scripts de seed

# --- Aplicação / Multi-tenant ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_STAKE=natal         # slug da Estaca renderizada na rota raiz "/" (fallback do MVP)

# --- Resend (e-mail transacional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@exemplo.org

# --- Check-in QR Code ---
QR_TOKEN_SECRET=                         # chave simétrica para assinar/validar tokens de check-in (gerar com `openssl rand -hex 32`)

# --- Jobs / Cron ---
CRON_SECRET=                             # usado para autenticar chamadas do pg_cron às Edge Functions

# --- Rate Limiting (se optar por Upstash em vez da tabela própria do Supabase) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
